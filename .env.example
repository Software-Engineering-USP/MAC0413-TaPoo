# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
ANA_IDENTIFICADOR=
ANA_SENHA=
ANA_BASE_URL=https://www.ana.gov.br/hidrowebservice/EstacoesTelemetricas
ANA_TIMEOUT_SEGUNDOS=20

# Onde os dados ficam: memoria (padrão fora do compose; some ao reiniciar) ou sql.
# No docker compose o padrão é sql, no Postgres do serviço "db".
REPO=
# Banco usado com REPO=sql. Vazio = SQLite em backend/tapoo.db.
# Ex.: postgresql://usuario:senha@host:5432/tapoo
DATABASE_URL=

# Origens do front liberadas no CORS, separadas por vírgula. Vazio bloqueia todas.
CORS_ORIGENS=http://localhost:3000,http://localhost:5173

